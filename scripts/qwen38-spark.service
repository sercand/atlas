# Qwen3.8-27B served by spark at 128k context x 4 concurrent sequences,
# alongside the vllm.service co-tenant on the same 121.6 GiB unified-memory GB10.
#
# Install:
#   sudo install -Dm644 scripts/qwen38-spark.service /etc/systemd/system/qwen38-spark.service
#   sudo systemctl daemon-reload && sudo systemctl restart qwen38-spark
#
# ─── MEMORY BUDGET (measured 2026-08-19, allocation ledger + boot log) ───────
#   total unified                                            121.6 GB
#   vllm.service (util 0.38-0.40) + python pipeline + OS      ~65.8 GB
#   Atlas pre-KV (weights 18.35 + arena 1.9 + vision 0.49)     21.4 GB
#   main KV pool: fills the remaining budget, floor 32,001
#     blocks (= 4 x 128,000 tok, else ATLAS_KV_OVERCOMMIT=0
#     refuses); measured boots landed 33,460-39,038 blocks    16.3-19.1 GB
#   MTP drafter KV (fp8, ATLAS_MTP_KV_DTYPE)                    1.0-1.2 GB
#   SSM pools + Marconi + drafter capture + GDN buffers         ~3.8 GB
#   ATLAS_HOST_RESERVE_GB (never handed out)                   12.0 GB
#   ────────────────────────────────────────────────────────────────
#   STEADY process (nvidia-smi, after request #1): 45.7 GiB — at, and
#   bounded by, the 0.38 x 121.6 = 46.2 GB budget. Judge footprint by the
#   one-shot `post-first-request footprint` log line, NOT the load-time
#   `post-load` line: the first request used to grow the process +9 GiB
#   via the lazy FFN MMQ rebuild (fixed 2026-08-19, commit 55796191 —
#   the MMQ arm now cycles one ~50 MiB arena scratch; STATE.md §10).
#   Want a ~4 GB deterministic margin instead of max prefix-cache
#   retention? Set ATLAS_KV_REUSE_FACTOR=1 (pool pins at 32,001 blocks).
#
# What made 128k x 4 fit (branch test/ladder-stack, 2026-08-19):
#   * weights 27.13 -> 18.35 GiB (ratio 1.41x -> 0.96x of the 19.18 GiB
#     checkpoint): the native-NVFP4 GDN arm now honours --low-memory (declines
#     the transposed twins + the FP8 out_proj predequant), retires the
#     concat'd in_proj_qkv/z store originals, and --low-memory retires the
#     BF16 lm_head once the NVFP4 head exists.
#   * ATLAS_MTP_KV_DTYPE=fp8 halves the drafter KV pool (2.0 -> 1.0 GiB at
#     128k x 4); ATLAS_CUDA_HEADROOM_MB=3072 hands the matching 1 GiB back to
#     the KV budget. NEVER lower the headroom without the fp8 pairing.
#   * --ssm-cache-slots 4 (was 8): Marconi prefix snapshots halve to ~0.6 GB.
#
# spark takes the SMALLER of two KV limits; the binding one on this box is
#   free-at-sizing − host-reserve − inference-reserve
# and free-at-boot must be ≥ ~54.5 GB for the 32,000-block working set to fit.
# A boot that lands while vllm is fat simply retries (Restart=always).

[Unit]
Description=spark serve Qwen3.8-27B (NVFP4, 128k x 4)
After=network-online.target vllm.service
Wants=network-online.target
# Retry forever: a boot that lands while a co-tenant is still claiming memory
# must be allowed to keep retrying, not hit systemd's 5-starts-in-10s limit.
StartLimitIntervalSec=0

[Service]
Type=simple
User=otsimo
Group=otsimo
WorkingDirectory=/home/otsimo

Environment=HOME=/home/otsimo
Environment=LIBRARY_PATH=/home/otsimo/nccl-shim
Environment=LD_LIBRARY_PATH=/home/otsimo/nccl-shim
Environment=ATLAS_LOW_MEMORY=1
Environment=ATLAS_PREFILL_CODISPATCH=1
Environment=ATLAS_FP8_ROWWISE=1
Environment=ATLAS_MTP_DCUT_RATIO=1.0
Environment=ATLAS_MTP_K_LADDER=1:3,2:1,4:2,8:2,16:1

# Host floor the KV pool may never eat into. Do NOT go below 12: on unified
# memory an under-reserved host does not fail with a clean CUDA OOM, it takes
# the box down.
Environment=ATLAS_HOST_RESERVE_GB=12

# Cap the pool at 2x the working set (max_batch_size x blocks/seq) instead of
# the default 4x — bounds the pool even on a boot where vllm is down.
Environment=ATLAS_KV_REUSE_FACTOR=2

# Refuse to boot when the pool cannot back max_batch_size sequences at
# max_seq_len. Combined with Restart=always this self-heals: spark retries
# until the co-tenant frees memory.
Environment=ATLAS_KV_OVERCOMMIT=0

# fp8 drafter KV: halves the MTP KV pool at 128k (2.0 -> 1.0 GiB). Risk is
# ACCEPTANCE only (drafts are always target-verified). A/B on 2026-08-19,
# decode-floor, one variable: fp8 accept_len 2.66 / 28.1 tok/s vs bf16 2.59 /
# 28.6 — no acceptance collapse, decode delta below the control's own
# run-to-run spread. Records run-1787121412932106666 / run-1787121760196788039.
Environment=ATLAS_MTP_KV_DTYPE=fp8

# 3 GiB CUDA headroom instead of the flat 4: legitimate ONLY because the fp8
# drafter pool above freed the matching 1 GiB. Revert BOTH together.
Environment=ATLAS_CUDA_HEADROOM_MB=3072

# vllm.service is Type=simple, so systemd calls it "started" the moment docker
# exec's. Wait for its health endpoint so spark sizes its KV pool against the
# TRUE free memory. Exits 0 either way, so spark still starts when vllm is
# deliberately down.
ExecStartPre=/bin/bash -c 'for i in $(seq 1 120); do curl -sf -m 3 -o /dev/null http://127.0.0.1:8010/health && break; sleep 5; done; exit 0'

ExecStart=/usr/local/bin/spark serve joshebbs/qwen3.8-27b-uncensored-nvfp4-modelopt \
    --host 0.0.0.0 --port 36200 --model-name Qwen3.8-27B \
    --max-seq-len 128000 --max-batch-size 4 --gpu-memory-utilization 0.38 \
    --max-prefill-tokens 4096 \
    --kv-cache-dtype fp8 --enable-prefix-caching true \
    --ssm-cache-slots 4 --ssm-checkpoint-interval 32 \
    --vision-max-pixels 1638400 \
    --speculative --num-drafts 3 --mtp-quantization bf16 \
    --scheduling-policy fifo --tool-call-parser qwen3_coder --disable-tool-grammar true \
    --request-timeout 0 --vision-allow-remote-images \
    --ssm-h-dtype f16-pool --gdn-fused-norm --ssm-batched-recurrent \
    --ssm-tail-midchunk false --mtp-gate force --prefill-varlen-batch --no-tui

Restart=always
# 60s, not 5s: a restart caused by a starved KV pool needs time for the
# co-tenant to settle.
RestartSec=60
# Model load can take a while; don't let systemd kill it mid-startup.
TimeoutStartSec=0
TimeoutStopSec=60
KillSignal=SIGINT
LimitNOFILE=65536
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
